{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "lint": "prettier --check . && stylelint --allow-empty-input \"**/*.{css,scss}\" && next lint",
    "format": "prettier --write .",
    "watch:next": "next dev",
    "watch:sass": "sass  --no-source-map --watch app/sass:app/styles",
    "build:sass": "sass  --no-source-map app/sass:app/styles",
    "build:local": "prettier --write . && next build",
    "build": "prettier --check . && stylelint --allow-empty-input \"**/*.{css,scss}\" && next build",
    "postbuild": "postcss app/styles/*.css -u autoprefixer cssnano -r --no-map",
    "start": "next start",
    "dev": "concurrently \"yarn watch:next\" \"yarn watch:sass\""
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@react-hook/resize-observer": "^2.0.1",
    "@react-hookz/web": "^24.0.4",
    "@react-three/drei": "^9.107.0",
    "@react-three/fiber": "^8.14.1",
    "@react-three/flex": "^1.0.1",
    "@react-three/offscreen": "^0.0.8",
    "@react-three/postprocessing": "^2.15.8",
    "@types/node": "20.14.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.165.0",
    "@vercel/edge-config": "^1.2.0",
    "caniuse-lite": "^1.0.30001636",
    "clsx": "^2.1.1",
    "eslint": "^8.41.0",
    "eslint-config-next": "^14.2.4",
    "next": "^14.2.4",
    "postcss-rgb": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-use": "^17.5.0",
    "sharp": "^0.33.4",
    "string-width": "7.1.0",
    "styled-components": "^6.1.9",
    "three": "^0.165.0",
    "typescript": "5.5.2",
    "uuidv4": "^6.2.13",
    "wrap-ansi": "9.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cssnano": "^7.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.27",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.77.6",
    "stylelint": "^16.6.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.1.0"
  }
}
